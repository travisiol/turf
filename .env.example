# ---------------------------------------------------------------------------
# TURF — configuration. Copy to .env.local (or set in Vercel). Everything
# NEXT_PUBLIC_* ships to the browser; keep keys out of it.
# ---------------------------------------------------------------------------

# The coin whose trades pay the turfs (a Pons V2 launch whose creator fee
# recipient is the Turf contract). Empty: no chart, no Trade link.
NEXT_PUBLIC_TOKEN_ADDRESS=

# The Turf game contract (constructor: Pons fee escrow, start price in wei).
NEXT_PUBLIC_TURF_ADDRESS=

# Block the Turf contract was deployed in. Takes are read from here; 0 reads
# the last 400,000 blocks only.
NEXT_PUBLIC_TURF_START_BLOCK=0

# Where "Trade on Pons" points. Empty: the token's Pons page.
NEXT_PUBLIC_TRADE_URL=

# WalletConnect Cloud project id (mobile wallets). Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=

# Network — defaults are Robinhood Chain (4663). Override only for a local
# hardhat node (chain 31337, http://127.0.0.1:8893).
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
